PORT=3001
NODE_ENV=development
APP_ENV=local
RUN_QUEUE_PROCESSORS=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nti_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://nti-*-klymenvladgmailcoms-projects.vercel.app
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=files
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
FILE_UPLOAD_PRESIGN_EXPIRES_SECONDS=900
FILE_UPLOAD_MAX_SIZE_BYTES=10485760
FILE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/rtf,text/plain
FILE_UPLOAD_VERIFY_OBJECT_ON_COMPLETE=false
ORGANIZATION_DOCUMENT_MAX_SIZE_BYTES=20971520
ORGANIZATION_DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ORGANIZATION_DOCUMENT_VERIFY_OBJECT_ON_COMPLETE=false
# Optional local/system browser path for puppeteer-core PDF rendering.
# Set this in your own `.env` when PDF export is enabled and the runtime
# cannot auto-resolve a browser executable.
# Examples:
# macOS Chrome: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# macOS Chromium: /Applications/Chromium.app/Contents/MacOS/Chromium
# Linux Chromium: /usr/bin/chromium
# Linux Chrome: /usr/bin/google-chrome
# Windows Chrome: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT_MS=30000
PDF_JOB_WAIT_TIMEOUT_MS=60000
PDF_WORKER_CONCURRENCY=2
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@example.com
EMAIL_LOGO_URL=https://your-cdn.example.com/icons/nti-logo.svg
JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_FORCE_PASSWORD_CHANGE_SECRET=your_force_password_change_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7d
ARGON2_TIME_COST=3
TOKEN_BYTE_LENGTH=32
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
DEV_EMAIL_VERIFICATION_BYPASS_ENABLED=false
PASSWORD_RESET_EXPIRATION_MINUTES=30
SYSTEM_INVITATION_EXPIRATION_HOURS=72
SUPERADMIN_TEMP_PASSWORD=change_me_before_seed
FORCE_PASSWORD_CHANGE_TOKEN_EXPIRATION_MINUTES=15

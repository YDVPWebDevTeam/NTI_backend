// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  COMPANY_OWNER
  COMPANY_EMPLOYEE
  MENTOR
  EVALUATOR
  CONTENT_EDITOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum UploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum OrganizationDocumentVisibility {
  INTERNAL
  CONFIDENTIAL
}

enum ProgramType {
  PROGRAM_A
  PROGRAM_B
}

enum BacklogItemStatus {
  DRAFT
  PUBLISHED
  IN_PAIRING
  ASSIGNED
  IN_REALIZATION
  CLOSED
  ARCHIVED
}

enum CallStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  FORMALLY_VERIFIED
  EVALUATING
  NEEDS_INFO
  APPROVED
  REJECTED
  ONBOARDING
  ACTIVE_PROJECT
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProgramBTeamApplicationStatus {
  SUBMITTED
  WITHDRAWN
  SHORTLISTED
  ACCEPTED
  REJECTED
  PROJECT_CREATED
}

enum DocumentType {
  EXECUTIVE_SUMMARY
  TECHNICAL_ARCHITECTURE
  ROADMAP
  BUDGET
  RISK_ANALYSIS
  MONETIZATION_MODEL
  CV
  MOTIVATION_LETTER
  SOLUTION_PROPOSAL
  OTHER
}

enum ApplicationDocumentScope {
  APPLICATION
  TEAM_MEMBER
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  OTHER
}

enum StudentStudyMode {
  FULL_TIME
  PART_TIME
}

enum StudentSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StudentFocusArea {
  SOFTWARE_DEVELOPMENT
  AI_AND_DATA
  WEB_APPLICATIONS
  GAME_DEVELOPMENT
  IOT_AND_EMBEDDED
  MOBILE_DEVELOPMENT
  DESKTOP_DEVELOPMENT
  QA_AND_TESTING
  DEVOPS_AND_INFRASTRUCTURE
  UI_UX_DESIGN
  PRODUCT_PROJECT_MANAGEMENT
}

enum StudentPreferredRole {
  FRONTEND
  BACKEND
  FULLSTACK
  MOBILE
  AI_DATA
  QA
  DEVOPS
  EMBEDDED
  GAME_DEV
  UI_UX
  PRODUCT_MANAGER
  TEAM_LEAD
}

enum StudentSoftSkill {
  TEAMWORK
  COMMUNICATION
  LEADERSHIP
  PRESENTATION
  PROBLEM_SOLVING
  TIME_MANAGEMENT
  PROJECT_COORDINATION
}

enum NeedsInfoItemStatus {
  OPEN
  ANSWERED
  RESOLVED
}

enum ProgramBProjectStatus {
  ACTIVE
  BLOCKED
  COMPLETED
  CLOSED
}

enum ProgramBMilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ProgramBPoDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum ProgramBBacklogDocumentCategory {
  TECHNICAL_SPECIFICATION
  SUPPORTING
  OTHER
}

enum ProgramBProjectDocumentCategory {
  OUTPUT
  FINAL_PRESENTATION
  DELIVERABLE
  OTHER
}

enum ProgramBDocumentVisibility {
  INTERNAL
  PARTICIPANTS
}

model User {
  id                 String  @id @default(uuid())
  firstName          String
  lastName           String
  email              String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(false)

  refreshTokens      RefreshToken[]
  passwordResetToken PasswordResetToken?

  role UserRole @default(STUDENT)

  status UserStatus @default(PENDING)

  isEmailConfirmed Boolean @default(false) @map("isConfirmed")

  confirmationToken EmailVerificationToken?

  isAdminConfirmed Boolean @default(false) @map("isAdminConfirmed")

  teams TeamMember[]

  leadOfTeams       Team[]             @relation("TeamLead")
  systemInvitesSent SystemInvitation[] @relation("SystemInvitationInvitedBy")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  studentProfile StudentProfile?

  uploads                       UploadedFile[]
  organizationDocumentsUploaded OrganizationDocument[] @relation("OrganizationDocumentUploadedBy")

  applicationsCreated              Application[]               @relation("ApplicationCreatedBy")
  assignedProgramAApplications     Application[]               @relation("ApplicationAssignedMentor")
  applicationEvaluations           ApplicationEvaluation[]     @relation("ApplicationEvaluationEvaluator")
  applicationDecisions             Application[]               @relation("ApplicationDecisionBy")
  programAMentorAssignmentsMade    Application[]               @relation("ApplicationMentorAssignedBy")
  updatedApplicationSections       ApplicationSection[]        @relation("ApplicationSectionUpdatedBy")
  applicationSectionHistories      ApplicationSectionHistory[] @relation("SectionHistorySavedBy")
  applicationDocumentsCreated      ApplicationDocument[]       @relation("ApplicationDocumentCreatedBy")
  applicationDocumentsForMember    ApplicationDocument[]       @relation("ApplicationDocumentMember")
  productOwnerForBacklogItems      BacklogItem[]               @relation("BacklogItemProductOwner")
  productOwnerForProgramBProjects  ProgramBProject[]           @relation("ProgramBProjectProductOwner")
  programBMentoringNotesAuthored   ProgramBMentoringNote[]     @relation("ProgramBMentoringNoteAuthor")
  programBPoReviewsAuthored        ProgramBPoReview[]          @relation("ProgramBPoReviewAuthor")
  auditEvents                      AuditEvent[]                @relation("AuditEventActor")
  requestedReportExportJobs        ReportExportJob[]           @relation("ReportExportJobRequestedBy")
  assignedProgramBProjectsAsMentor ProgramBProject[]           @relation("ProgramBProjectMentor")
  programBMentorAssignmentsMade    ProgramBProject[]           @relation("ProgramBProjectMentorAssignedBy")

  needsInfoItemsCreated           NeedsInfoItem[]          @relation("NeedsInfoCreatedBy")
  needsInfoItemsResolved          NeedsInfoItem[]          @relation("NeedsInfoResolvedBy")
  needsInfoRepliesCreated         NeedsInfoReply[]         @relation("NeedsInfoReplyCreatedBy")
  applicationStatusEventsChanged  ApplicationStatusEvent[] @relation("ApplicationStatusChangedBy")
  programAMentorshipNotesAuthored ProgramAMentorshipNote[] @relation("ProgramAMentorshipNoteAuthor")

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  programBTeamApplications   ProgramBTeamApplication[]
  programBTeamApplicationCvs ProgramBTeamApplicationCv[]
  programBBacklogDocuments   ProgramBBacklogDocument[]
  programBProjectDocuments   ProgramBProjectDocument[]

  @@index([organizationId])
  @@index([role, status])
  @@index([status, createdAt])
}

model UploadedFile {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  key          String @unique
  originalName String
  mimeType     String
  size         Int

  purpose    String?
  entityType String?
  entityId   String?
  visibility FileVisibility @default(PRIVATE)

  status UploadStatus @default(PENDING)

  uploadUrlExpiresAt DateTime
  uploadedAt         DateTime?
  failedAt           DateTime?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  academicEvidenceFor        StudentProfile[]            @relation("StudentAcademicEvidence")
  cvFor                      StudentProfile[]            @relation("StudentCvFile")
  applicationDocuments       ApplicationDocument[]
  programBTeamApplications   ProgramBTeamApplication[]
  programBBacklogDocuments   ProgramBBacklogDocument[]
  programBProjectDocuments   ProgramBProjectDocument[]
  programBTeamApplicationCvs ProgramBTeamApplicationCv[]
  reportExportJobs           ReportExportJob[]

  @@index([ownerId, status])
  @@index([status, uploadUrlExpiresAt])
  @@index([entityType, entityId])
}

model TeamMember {
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

model Team {
  id   String @id @default(uuid())
  name String

  leaderId String
  leader   User   @relation("TeamLead", fields: [leaderId], references: [id])

  members TeamMember[]

  invitations      Invitation[]
  applications     Application[]
  programBProjects ProgramBProject[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  lockedAt                 DateTime? // When a team is locked, it cannot be modified (e.g., members cannot be added or removed)
  archivedAt               DateTime?
  programBTeamApplications ProgramBTeamApplication[]

  @@index([leaderId])
  @@index([archivedAt])
}

model Call {
  id String @id @default(uuid())

  type     ProgramType
  title    String
  status   CallStatus  @default(DRAFT)
  opensAt  DateTime?
  closesAt DateTime?

  applications Application[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  requiredDocumentTypes  RequiredDocumentType[]
  eligibilityRuleConfigs EligibilityRuleConfig[]

  @@index([type, status])
  @@index([status, opensAt, closesAt])
}

model Application {
  id String @id @default(uuid())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User                  @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  documents   ApplicationDocument[]

  needsInfoItems     NeedsInfoItem[]
  statusEvents       ApplicationStatusEvent[]
  eligibilitySignals EligibilitySignal[]
  mentorUserId       String?
  mentorUser         User?                    @relation("ApplicationAssignedMentor", fields: [mentorUserId], references: [id], onDelete: SetNull)
  mentorAssignedAt   DateTime?
  mentorAssignedById String?
  mentorAssignedBy   User?                    @relation("ApplicationMentorAssignedBy", fields: [mentorAssignedById], references: [id], onDelete: SetNull)

  mentorshipNotes  ProgramAMentorshipNote[]
  programBProjects ProgramBProject[]

  status      ApplicationStatus @default(DRAFT)
  submittedAt DateTime?
  decidedAt   DateTime?

  decisionById      String?
  decisionBy        User?   @relation("ApplicationDecisionBy", fields: [decisionById], references: [id])
  decisionRationale String?

  evaluations ApplicationEvaluation[]

  sections ApplicationSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId, status])
  @@index([teamId, status])
  @@index([createdById, status])
  @@index([mentorUserId, status])
  @@index([mentorAssignedById])
  @@index([decisionById])
}

model ApplicationEvaluation {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  evaluatorId String
  evaluator   User   @relation("ApplicationEvaluationEvaluator", fields: [evaluatorId], references: [id])

  recommendation EvaluationRecommendation?
  comment        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores ApplicationEvaluationScore[]

  @@unique([applicationId, evaluatorId])
  @@index([applicationId, createdAt])
  @@index([applicationId, evaluatorId])
}

model ApplicationEvaluationScore {
  id           String                @id @default(uuid())
  evaluationId String
  evaluation   ApplicationEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  criterionCode String
  score         Decimal
  comment       String?

  @@unique([evaluationId, criterionCode])
  @@index([criterionCode])
}

model ProgramAMentorshipNote {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ProgramAMentorshipNoteAuthor", fields: [authorId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt, id])
  @@index([authorId, createdAt])
}

model EligibilitySignal {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  code      String
  passed    Boolean
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, code])
  @@index([applicationId])
}

model EligibilityRuleConfig {
  id String @id @default(uuid())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  code      String
  enabled   Boolean  @default(true)
  threshold String?
  createdAt DateTime @default(now())

  @@unique([callId, code])
}

model ProgramBTeamApplication {
  id             String                        @id @default(uuid())
  backlogItemId  String
  teamId         String
  createdById    String
  motivation     String
  proposalText   String?
  proposalFileId String?
  status         ProgramBTeamApplicationStatus @default(SUBMITTED)
  submittedAt    DateTime                      @default(now())
  shortlistedAt  DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  withdrawnAt    DateTime?
  decisionReason String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  backlogItem     BacklogItem                 @relation(fields: [backlogItemId], references: [id])
  team            Team                        @relation(fields: [teamId], references: [id])
  createdBy       User                        @relation(fields: [createdById], references: [id])
  proposalFile    UploadedFile?               @relation(fields: [proposalFileId], references: [id])
  cvAttachments   ProgramBTeamApplicationCv[]
  programBProject ProgramBProject?

  @@index([backlogItemId, teamId], map: "idx_pb_app_backlog_team")
  @@index([status], map: "idx_pb_app_status")
}

model ProgramBTeamApplicationCv {
  id               String   @id @default(uuid())
  applicationId    String
  teamMemberUserId String
  uploadedFileId   String
  createdAt        DateTime @default(now())

  application    ProgramBTeamApplication @relation(fields: [applicationId], references: [id])
  teamMemberUser User                    @relation(fields: [teamMemberUserId], references: [id])
  uploadedFile   UploadedFile            @relation(fields: [uploadedFileId], references: [id])

  @@unique([applicationId, teamMemberUserId], map: "uq_pb_app_cv_team_member")
  @@index([applicationId], map: "idx_pb_app_cv_application")
  @@index([uploadedFileId], map: "idx_pb_app_cv_file")
}

model BacklogItem {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title            String?
  description      String?
  budget           Int?
  expectedOutcomes String?

  productOwnerUserId String?
  productOwner       User?             @relation("BacklogItemProductOwner", fields: [productOwnerUserId], references: [id], onDelete: SetNull)
  programBProjects   ProgramBProject[]

  status BacklogItemStatus @default(DRAFT)

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  programBTeamApplications ProgramBTeamApplication[]
  documents                ProgramBBacklogDocument[]

  @@index([organizationId])
  @@index([status])
  @@index([updatedAt])
  @@index([organizationId, updatedAt])
}

model OrganizationDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  documentType String
  version      Int

  storagePath String  @unique
  mimeType    String
  sizeBytes   Int
  checksum    String?

  visibility OrganizationDocumentVisibility @default(INTERNAL)
  status     UploadStatus                   @default(PENDING)

  uploadUrlExpiresAt DateTime
  uploadedAt         DateTime?
  failedAt           DateTime?

  uploadedById String
  uploadedBy   User   @relation("OrganizationDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([organizationId, name, version])
  @@index([organizationId, name, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, uploadUrlExpiresAt])
}

model RequiredDocumentType {
  id String @id @default(uuid())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  documentType DocumentType
  isRequired   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([callId, documentType])
  @@index([callId, isRequired])
}

model ApplicationDocument {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  uploadedFileId String
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  documentType  DocumentType
  documentScope ApplicationDocumentScope

  memberUserId String?
  memberUser   User?   @relation("ApplicationDocumentMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  version  Int     @default(1)
  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("ApplicationDocumentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId, documentType, isActive])
  @@index([applicationId, documentScope, isActive])
  @@index([applicationId, memberUserId, documentType, isActive])
  @@index([uploadedFileId])
}

model ApplicationSection {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  key           String
  valueJson     Json
  version       Int                         @default(1)
  activeVersion Int?
  history       ApplicationSectionHistory[]

  updatedById String
  updatedBy   User   @relation("ApplicationSectionUpdatedBy", fields: [updatedById], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([applicationId, key])
}

model ApplicationSectionHistory {
  id        String             @id @default(uuid())
  sectionId String
  section   ApplicationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  version   Int
  valueJson Json
  savedById String
  savedBy   User               @relation("SectionHistorySavedBy", fields: [savedById], references: [id])
  createdAt DateTime           @default(now())

  @@unique([sectionId, version])
}

model NeedsInfoItem {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  message String
  dueAt   DateTime?

  status NeedsInfoItemStatus @default(OPEN)

  createdById String
  createdBy   User   @relation("NeedsInfoCreatedBy", fields: [createdById], references: [id])

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("NeedsInfoResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())

  replies      NeedsInfoReply[]
  statusEvents ApplicationStatusEvent[]

  @@index([applicationId, createdAt])
  @@index([applicationId, status])
}

model NeedsInfoReply {
  id              String        @id @default(uuid())
  needsInfoItemId String
  needsInfoItem   NeedsInfoItem @relation(fields: [needsInfoItemId], references: [id], onDelete: Cascade)

  message String

  createdById String
  createdBy   User   @relation("NeedsInfoReplyCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([needsInfoItemId, createdAt])
}

model ProgramBProject {
  id String @id @default(uuid())

  backlogItemId String
  backlogItem   BacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Restrict)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  teamApplicationId String?                  @unique
  teamApplication   ProgramBTeamApplication? @relation(fields: [teamApplicationId], references: [id], onDelete: Restrict)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  productOwnerUserId String
  productOwnerUser   User   @relation("ProgramBProjectProductOwner", fields: [productOwnerUserId], references: [id], onDelete: Restrict)

  mentorUserId String?
  mentorUser   User?   @relation("ProgramBProjectMentor", fields: [mentorUserId], references: [id], onDelete: SetNull)

  mentorAssignedAt   DateTime?
  mentorAssignedById String?
  mentorAssignedBy   User?     @relation("ProgramBProjectMentorAssignedBy", fields: [mentorAssignedById], references: [id], onDelete: SetNull)

  status ProgramBProjectStatus @default(ACTIVE)

  acceptedByCompanyAt DateTime?
  acceptedByNtiAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones     ProgramBMilestone[]
  mentoringNotes ProgramBMentoringNote[]
  poReviews      ProgramBPoReview[]
  documents      ProgramBProjectDocument[]

  @@index([teamId])
  @@index([backlogItemId])
  @@index([applicationId])
  @@index([teamApplicationId])
  @@index([productOwnerUserId])
  @@index([mentorUserId])
  @@index([mentorAssignedById])
  @@index([status])
}

model ProgramBMilestone {
  id String @id @default(uuid())

  projectId String
  project   ProgramBProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueAt       DateTime?
  status      ProgramBMilestoneStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model ProgramBBacklogDocument {
  id String @id @default(uuid())

  backlogItemId String
  backlogItem   BacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)

  uploadedFileId String
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  category   ProgramBBacklogDocumentCategory
  visibility ProgramBDocumentVisibility      @default(PARTICIPANTS)
  version    Int                             @default(1)
  isActive   Boolean                         @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([backlogItemId, category, version], map: "uq_pb_backlog_doc_version")
  @@index([backlogItemId, category, isActive])
  @@index([uploadedFileId])
}

model ProgramBProjectDocument {
  id String @id @default(uuid())

  projectId String
  project   ProgramBProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedFileId String
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  category   ProgramBProjectDocumentCategory
  visibility ProgramBDocumentVisibility      @default(PARTICIPANTS)
  version    Int                             @default(1)
  isActive   Boolean                         @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, category, version], map: "uq_pb_project_doc_version")
  @@index([projectId, category, isActive])
  @@index([uploadedFileId])
}

model ProgramBMentoringNote {
  id String @id @default(uuid())

  projectId String
  project   ProgramBProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorUserId String
  authorUser   User   @relation("ProgramBMentoringNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  note String

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProgramBPoReview {
  id String @id @default(uuid())

  projectId String
  project   ProgramBProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorUserId String
  authorUser   User   @relation("ProgramBPoReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  decision ProgramBPoDecision
  comment  String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ApplicationStatusEvent {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus
  toStatus   ApplicationStatus

  changedById String
  changedBy   User   @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id])

  reason          String?
  needsInfoItemId String?
  needsInfoItem   NeedsInfoItem? @relation(fields: [needsInfoItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([needsInfoItemId])
}

enum EvaluationRecommendation {
  APPROVE
  REJECT
  NEEDS_INFO
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SystemInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id    String @id @default(uuid())
  email String

  token String @unique

  status InvitationStatus @default(PENDING)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([teamId, status, expiresAt])
  @@index([email])
}

model EmailVerificationToken {
  id    String @id @default(uuid())
  token String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  @@index([expiresAt])
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model Organization {
  id           String                 @id @default(uuid())
  name         String
  ico          String                 @unique
  sector       String?
  description  String?
  website      String?
  logoUrl      String?
  status       OrganizationStatus     @default(PENDING)
  users        User[]
  invitations  OrgInvitation[]
  backlogItems BacklogItem[]
  documents    OrganizationDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model OrgInvitation {
  id    String @id @default(uuid())
  email String
  token String @unique

  roleToAssign UserRole
  status       InvitationStatus @default(PENDING)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  revokedById    String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  @@index([organizationId, status, expiresAt])
  @@index([email, status, expiresAt])
  @@index([expiresAt])
}

model SystemInvitation {
  id    String @id @default(uuid())
  email String
  token String @unique

  roleToAssign UserRole
  status       SystemInvitationStatus @default(PENDING)

  invitedById String
  invitedBy   User   @relation("SystemInvitationInvitedBy", fields: [invitedById], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([status, expiresAt, email])
  @@index([email, roleToAssign, status, expiresAt])
}

model AuditEvent {
  id String @id @default(uuid())

  actorUserId String
  actorUser   User   @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  action     String
  entityType String
  entityId   String
  metadata   Json

  createdAt DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model ReportExportJob {
  id String @id

  requestedByUserId String
  requestedByUser   User   @relation("ReportExportJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  dataset String
  format  String
  status  String

  completedAt  DateTime?
  errorMessage String?

  uploadedFileId String?
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)

  downloadTokenHash      String?
  downloadTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestedByUserId, createdAt])
  @@index([status, createdAt])
}

model University {
  id        String  @id @default(uuid())
  name      String  @unique
  shortName String? @unique
  website   String?
  city      String?
  country   String? @default("sk")
  isActive  Boolean @default(true)

  faculties Faculty[]
  students  StudentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Faculty {
  id           String     @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name      String
  shortName String?
  isActive  Boolean @default(true)

  specializations Specialization[]
  students        StudentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId, isActive])
}

model Specialization {
  id        String  @id @default(uuid())
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  degreeLabel String?
  isActive    Boolean @default(true)

  students StudentProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facultyId, name])
  @@index([facultyId, isActive])
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Restrict)

  degreeLevel DegreeLevel
  studyMode   StudentStudyMode?
  studyYear   Int

  expectedGraduationYear Int?

  hasTransferredSubjects   Boolean?
  transferredSubjectsCount Int?
  profileSubjectsAverage   Float?

  relevantCourses      String[]
  academicAchievements String?

  academicEvidenceFileId String?
  academicEvidenceFile   UploadedFile? @relation("StudentAcademicEvidence", fields: [academicEvidenceFileId], references: [id], onDelete: SetNull)

  academicDeclarationAcceptedAt DateTime?
  profileCompletedAt            DateTime?

  focusAreas     StudentFocusArea[]
  preferredRoles StudentPreferredRole[]
  softSkills     StudentSoftSkill[]

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  bio          String?

  cvFileId String?
  cvFile   UploadedFile? @relation("StudentCvFile", fields: [cvFileId], references: [id], onDelete: SetNull)

  skills   StudentSkill[]
  projects StudentProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@index([facultyId])
  @@index([specializationId])
  @@index([degreeLevel, studyYear])
  @@index([profileCompletedAt])
}

model StudentSkill {
  id String @id @default(uuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  name             String
  level            StudentSkillLevel
  experienceMonths Int?
  isPrimary        Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentProfileId])
  @@index([studentProfileId, level])
  @@index([name])
}

model StudentProject {
  id String @id @default(uuid())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  title        String
  description  String
  role         String
  technologies String[]
  projectUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentProfileId])
}
